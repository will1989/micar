<view class="app {{wide ? 'wide' : ''}} {{mode == 'gamepad' ? 'dual' : ''}}">

  <view class="topbar">
    <view class="brand">
      <text class="logo">🚗</text>
      <view class="brand-text">
        <text class="title">MiCar 遥控</text>
        <text class="sub">{{deviceName}}</text>
      </view>
    </view>
    <view class="status">
      <text class="pill {{connected ? 'on' : 'off'}}">{{statusText}}</text>
      <text class="battery">{{battery}}</text>
    </view>
  </view>

  <button class="connect-btn" bindtap="onConnectTap" disabled="{{connecting}}">
    <text wx:if="{{connected}}">断开连接</text>
    <text wx:elif="{{connecting}}">连接中…</text>
    <text wx:else>连接小车</text>
  </button>
  <text class="compat-note" wx:if="{{compatNote}}">{{compatNote}}</text>

  <view class="tabs">
    <view class="tab {{mode == 'gamepad' ? 'active' : ''}}" data-mode="gamepad" bindtap="onModeTap">双手柄</view>
    <view class="tab {{mode == 'dpad' ? 'active' : ''}}" data-mode="dpad" bindtap="onModeTap">方向键</view>
    <view class="tab {{mode == 'joystick' ? 'active' : ''}}" data-mode="joystick" bindtap="onModeTap">摇杆</view>
    <view class="tab {{mode == 'gravity' ? 'active' : ''}}" data-mode="gravity" bindtap="onModeTap">重力</view>
  </view>

  <view class="panel">

    <view class="pane pane-left" wx:if="{{mode == 'dpad' || mode == 'gamepad'}}">
      <view class="demo-note" wx:if="{{!connected}}">未连接小车 · 操作演示（指令不会下发）</view>
      <view class="zone-label" wx:if="{{mode == 'gamepad'}}">L · 油门</view>

      <!-- 双手柄只保留前进 / 后退（左手油门）；wx:else 的单区模式保留完整四向作为备用 -->
      <view class="dpad throttle-pad" wx:if="{{mode == 'gamepad'}}">
        <view class="dbtn throttle-btn up {{activeDir == 'forward' ? 'held' : ''}}" data-cmd="forward" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">▲</view>
        <view class="dbtn throttle-btn down {{activeDir == 'backward' ? 'held' : ''}}" data-cmd="backward" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">▼</view>
      </view>

      <view class="dpad" wx:else>
        <view class="dpad-row">
          <view class="dpad-cell"></view>
          <view class="dbtn {{activeDir == 'forward' ? 'held' : ''}}" data-cmd="forward" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">▲</view>
          <view class="dpad-cell"></view>
        </view>
        <view class="dpad-row">
          <view class="dbtn {{activeDir == 'left' ? 'held' : ''}}" data-cmd="left" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">◀</view>
          <view class="dbtn stop {{activeDir == 'stop' ? 'held' : ''}}" data-cmd="stop" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">●</view>
          <view class="dbtn {{activeDir == 'right' ? 'held' : ''}}" data-cmd="right" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">▶</view>
        </view>
        <view class="dpad-row">
          <view class="dpad-cell"></view>
          <view class="dbtn {{activeDir == 'backward' ? 'held' : ''}}" data-cmd="backward" bindtouchstart="onDirStart" bindtouchend="onDirEnd" bindtouchcancel="onDirEnd">▼</view>
          <view class="dpad-cell"></view>
        </view>
      </view>

      <view class="readout">
        <text>转向 {{steerReadout}}</text>
        <text>油门 {{throttleReadout}}</text>
      </view>
      <view class="dir-state {{activeDir ? 'on' : ''}}">{{activeDir ? dirLabel : idleDirText}}</view>
      <text class="hint" wx:if="{{mode != 'gamepad'}}">按住方向键行驶，松开自动回中停车；中间 ● 立即停车</text>
      <text class="hint" wx:if="{{mode == 'gamepad'}}">左手油门：按住前进 / 后退，松开即停；右侧摇杆可 360° 控制转向与油门</text>
    </view>

    <view class="pane pane-right" wx:if="{{mode == 'joystick' || mode == 'gamepad'}}">
      <view class="demo-note" wx:if="{{!connected}}">未连接小车 · 操作演示（指令不会下发）</view>
      <view class="zone-label" wx:if="{{mode == 'gamepad'}}">R · 摇杆</view>
      <view id="joystick" class="joystick {{joyPressed ? 'active' : ''}} {{mode == 'gamepad' && joyAxis == 'steer' ? 'steer-only' : ''}}" catchtouchstart="onJoyStart" catchtouchmove="onJoyMove" catchtouchend="onJoyEnd" catchtouchcancel="onJoyEnd">
        <view class="joystick-cross"></view>
        <view class="joystick-knob {{joyPressed ? 'active' : ''}}" style="transform: translate({{joyX}}px, {{joyY}}px)"></view>
      </view>
      <view class="joy-meta" wx:if="{{mode == 'gamepad'}}">
        <view class="angle-readout">转向角 <text class="angle-val">{{angleText}}</text></view>
        <view class="axis-switch">
          <view class="axis-btn {{joyAxis == 'full' ? 'active' : ''}}" data-axis="full" bindtap="onJoyAxisTap">360° 全向</view>
          <view class="axis-btn {{joyAxis == 'steer' ? 'active' : ''}}" data-axis="steer" bindtap="onJoyAxisTap">仅转向</view>
        </view>
      </view>
      <view class="readout">
        <text>转向 {{steerReadout}}</text>
        <text>油门 {{throttleReadout}}</text>
      </view>
      <view class="dir-state {{joyPressed ? 'on' : ''}}">{{joyPressed ? joyActiveText : idleJoyText}}</view>
      <text class="hint" wx:if="{{mode != 'gamepad'}}">拖动摇杆：上下控制油门，左右控制转向；松手回中</text>
      <text class="hint" wx:if="{{mode == 'gamepad'}}">右手摇杆 360° 拖动：左右转向、上下油门；按下左侧方向键时优先作为油门</text>
    </view>

    <view class="pane" wx:if="{{mode == 'gravity'}}">
      <view class="gravity-tilt" style="transform: rotate({{tiltX}}deg) rotateX({{tiltY}}deg)">
        <text class="tilt-phone">📱</text>
      </view>
      <text class="gravity-state" wx:if="{{gravityRunning && gravityCalibrated}}">运行中</text>
      <text class="gravity-state" wx:elif="{{gravityRunning}}">采集中点…</text>
      <text class="gravity-state" wx:else>未开启</text>
      <view class="readout">
        <text>转向 {{steerReadout}}</text>
        <text>油门 {{throttleReadout}}</text>
      </view>
      <view class="gravity-actions">
        <button class="mini-btn" bindtap="onGravityEnable">{{gravityRunning ? '关闭重力' : '开启重力感应'}}</button>
        <button class="mini-btn" bindtap="onGravityCalib">校准居中</button>
      </view>
      <text class="hint">平放握持，前倾加速、左右倾斜转向；开启后自动以当前姿态为中点</text>
    </view>

  </view>

  <view class="controls">
    <view class="ctrl-item">
      <text class="ctrl-label">灯光</text>
      <button class="toggle {{lightsOn ? 'on' : ''}}" bindtap="onLightTap">{{lightsOn ? '开' : '关'}}</button>
    </view>
    <view class="ctrl-item">
      <text class="ctrl-label">档位</text>
      <view class="gear">
        <view class="gear-btn {{gear == 0.5 ? 'active' : ''}}" data-gear="0.5" bindtap="onGearTap">低</view>
        <view class="gear-btn {{gear == 0.75 ? 'active' : ''}}" data-gear="0.75" bindtap="onGearTap">中</view>
        <view class="gear-btn {{gear == 1 ? 'active' : ''}}" data-gear="1" bindtap="onGearTap">高</view>
      </view>
    </view>
    <view class="ctrl-item wide">
      <text class="ctrl-label">转向微调 {{trim}}</text>
      <slider class="trim-slider" min="-300" max="300" step="10" value="{{trim}}" activeColor="#22d3ee" block-size="20" bindchange="onTrimChange" bindchanging="onTrimChange" />
    </view>
    <view class="ctrl-item">
      <button class="mini-btn" bindtap="onBatteryTap">刷新电量</button>
    </view>
  </view>

  <view class="log-zone">
    <view class="log-head">
      <text>日志</text>
      <button class="mini-btn ghost" bindtap="onClearLog">清空</button>
    </view>
    <scroll-view class="log" scroll-y scroll-top="{{logScrollTop}}">
      <view wx:for="{{logs}}" wx:key="id" class="log-line {{item.kind}}">{{item.text}}</view>
    </scroll-view>
  </view>

  <text class="foot">协议逆向 Matt Cree · 爱好者复刻，与小米无官方关联</text>

  <!-- 微信要求：用户同意隐私保护指引后，方可调用蓝牙/定位/加速度计等隐私接口 -->
  <view class="privacy-mask" wx:if="{{showPrivacy}}" catchtouchmove="onPrivacyMaskMove">
    <view class="privacy-dialog">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-text">使用蓝牙遥控前，请阅读并同意《用户隐私保护指引》。本小程序仅在本地连接遥控小车，不上传、不保存你的个人信息。</text>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看《用户隐私保护指引》</text>
      <view class="privacy-actions">
        <button class="privacy-btn ghost" bindtap="onPrivacyDisagree">不同意</button>
        <button id="agree-btn" class="privacy-btn primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgree">同意并继续</button>
      </view>
    </view>
  </view>
</view>
