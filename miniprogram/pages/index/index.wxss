page {
  min-height: 100%;
  background: #0f1115;
  color: #e6e9ef;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
}
button::after {
  border: none;
}

.app {
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 40rpx;
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.brand {
  display: flex;
  align-items: center;
}
.logo {
  font-size: 52rpx;
  margin-right: 16rpx;
}
.brand-text {
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.sub {
  font-size: 22rpx;
  color: #8b93a3;
}
.status {
  display: flex;
  align-items: center;
}
.pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
  margin-right: 12rpx;
}
.pill.off {
  background: #2a2f3a;
  color: #8b93a3;
}
.pill.on {
  background: rgba(52, 211, 153, 0.15);
  color: #34d399;
  border: 2rpx solid rgba(52, 211, 153, 0.4);
}
.battery {
  font-size: 24rpx;
  color: #8b93a3;
  min-width: 76rpx;
  text-align: right;
}

/* 连接 */
.connect-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
}
.connect-btn[disabled] {
  opacity: 0.65;
  color: #04121a;
}
.compat-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #fbbf24;
  line-height: 1.6;
  text-align: center;
}

/* Tabs */
.tabs {
  display: flex;
  background: #1a1d24;
  padding: 10rpx;
  border-radius: 24rpx;
  margin: 28rpx 0 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8b93a3;
}
.tab.active {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(59, 130, 246, 0.18));
  color: #e6e9ef;
  border: 2rpx solid rgba(34, 211, 238, 0.35);
}

.panel {
  min-height: 480rpx;
}
.pane {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8b93a3;
  line-height: 1.6;
  text-align: center;
}

/* 方向键 */
.dpad {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dpad-row {
  display: flex;
  justify-content: center;
  align-items: center;
}
.dpad-cell {
  width: 180rpx;
  height: 180rpx;
}
.dbtn {
  width: 180rpx;
  height: 180rpx;
  margin: 10rpx;
  border-radius: 36rpx;
  background: #232730;
  color: #e6e9ef;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}
.dbtn.held {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
}
.dbtn.stop {
  font-size: 32rpx;
  color: #f87171;
}

/* 摇杆 */
.joystick {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #20242e, #14171d);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.05), 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}
.joystick-cross {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.joystick-cross::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 8%;
  bottom: 8%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.06);
}
.joystick-cross::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 8%;
  right: 8%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.06);
}
.joystick-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 148rpx;
  height: 148rpx;
  margin-left: -74rpx;
  margin-top: -74rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  box-shadow: 0 10rpx 28rpx rgba(34, 211, 238, 0.4);
}
.readout {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 16rpx;
}
.readout text {
  font-size: 26rpx;
  color: #8b93a3;
  margin: 0 28rpx;
}

/* 重力 */
.gravity-tilt {
  width: 300rpx;
  height: 300rpx;
  border-radius: 44rpx;
  background: #232730;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
}
.tilt-phone {
  font-size: 110rpx;
}
.gravity-state {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8b93a3;
}
.gravity-actions {
  display: flex;
  margin-top: 12rpx;
}

/* 控制条 */
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  background: #1a1d24;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-top: 28rpx;
}
.ctrl-item {
  display: flex;
  flex-direction: column;
  margin-right: 28rpx;
  margin-bottom: 16rpx;
}
.ctrl-item.wide {
  width: 100%;
  margin-right: 0;
}
.ctrl-label {
  font-size: 24rpx;
  color: #8b93a3;
  margin-bottom: 12rpx;
}
.toggle {
  min-width: 120rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #232730;
  color: #8b93a3;
  font-size: 28rpx;
  font-weight: 700;
}
.toggle.on {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
}
.gear {
  display: flex;
  background: #232730;
  padding: 8rpx;
  border-radius: 18rpx;
}
.gear-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b93a3;
}
.gear-btn.active {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
}
.mini-btn {
  padding: 16rpx 28rpx;
  border-radius: 18rpx;
  background: #232730;
  color: #e6e9ef;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0 10rpx;
}
.gravity-actions .mini-btn {
  margin: 0 8rpx;
}

/* 日志 */
.log-zone {
  background: #1a1d24;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.log-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.log-head text {
  font-size: 24rpx;
  color: #8b93a3;
}
.mini-btn.ghost {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #8b93a3;
  padding: 8rpx 20rpx;
}
.log {
  height: 240rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  color: #9fb0c3;
}
.log-line {
  word-break: break-all;
}
.log-line.ok {
  color: #34d399;
}
.log-line.err {
  color: #f87171;
}
.log-line.warn {
  color: #fbbf24;
}

.foot {
  margin-top: 32rpx;
  font-size: 20rpx;
  color: #5b6373;
  text-align: center;
  line-height: 1.6;
}
