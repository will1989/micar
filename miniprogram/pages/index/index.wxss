page {
  min-height: 100%;
  background: #0f1115;
  color: #e6e9ef;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
}
button::after {
  border: none;
}

.app {
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 40rpx;
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.brand {
  display: flex;
  align-items: center;
}
.logo {
  font-size: 52rpx;
  margin-right: 16rpx;
}
.brand-text {
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.sub {
  font-size: 22rpx;
  color: #8b93a3;
}
.status {
  display: flex;
  align-items: center;
}
.pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
  margin-right: 12rpx;
}
.pill.off {
  background: #2a2f3a;
  color: #8b93a3;
}
.pill.on {
  background: rgba(52, 211, 153, 0.15);
  color: #34d399;
  border: 2rpx solid rgba(52, 211, 153, 0.4);
}
.battery {
  font-size: 24rpx;
  color: #8b93a3;
  min-width: 76rpx;
  text-align: right;
}

/* 连接 */
.connect-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
}
.connect-btn[disabled] {
  opacity: 0.65;
  color: #04121a;
}
.compat-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #fbbf24;
  line-height: 1.6;
  text-align: center;
}

/* Tabs */
.tabs {
  display: flex;
  background: #1a1d24;
  padding: 10rpx;
  border-radius: 24rpx;
  margin: 28rpx 0 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8b93a3;
}
.tab.active {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(59, 130, 246, 0.18));
  color: #e6e9ef;
  border: 2rpx solid rgba(34, 211, 238, 0.35);
}

.panel {
  min-height: 480rpx;
}
.pane {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8b93a3;
  line-height: 1.6;
  text-align: center;
}

/* 方向键 */
.dpad {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dpad-row {
  display: flex;
  justify-content: center;
  align-items: center;
}
.dpad-cell {
  width: 180rpx;
  height: 180rpx;
}
.dbtn {
  width: 180rpx;
  height: 180rpx;
  margin: 10rpx;
  border-radius: 36rpx;
  background: #232730;
  color: #e6e9ef;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
  transition: transform .1s ease, background .12s ease, box-shadow .14s ease, filter .12s ease;
}
.dbtn.held {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
  transform: scale(.9);
  filter: brightness(1.08);
  box-shadow: 0 0 0 6rpx rgba(34, 211, 238, 0.2), 0 8rpx 44rpx rgba(34, 211, 238, 0.55);
}
.dbtn.stop {
  font-size: 32rpx;
  color: #f87171;
}

/* 摇杆 */
.joystick {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #20242e, #14171d);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.05), 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}
.joystick-cross {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.joystick-cross::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 8%;
  bottom: 8%;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.06);
}
.joystick-cross::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 8%;
  right: 8%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.06);
}
.joystick {
  transition: box-shadow .15s ease;
}
.joystick.active {
  box-shadow: inset 0 0 0 4rpx rgba(34, 211, 238, 0.35), 0 0 0 6rpx rgba(34, 211, 238, 0.12), 0 0 48rpx rgba(34, 211, 238, 0.3);
}
.joystick-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 148rpx;
  height: 148rpx;
  margin-left: -74rpx;
  margin-top: -74rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  box-shadow: 0 10rpx 28rpx rgba(34, 211, 238, 0.4);
  transition: box-shadow .14s ease, filter .14s ease;
}
.joystick-knob.active {
  filter: brightness(1.14);
  box-shadow: 0 0 0 10rpx rgba(34, 211, 238, 0.16), 0 10rpx 44rpx rgba(34, 211, 238, 0.8);
}

/* 演示提示与实时状态 */
.demo-note {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(251, 191, 36, 0.1);
  border: 1rpx solid rgba(251, 191, 36, 0.28);
  color: #fbbf24;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
.dir-state {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b93a3;
  text-align: center;
  transition: color .12s ease;
}
.dir-state.on {
  color: #22d3ee;
  font-weight: 600;
}
.readout {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 16rpx;
}
.readout text {
  font-size: 26rpx;
  color: #8b93a3;
  margin: 0 28rpx;
}

/* 重力 */
.gravity-tilt {
  width: 300rpx;
  height: 300rpx;
  border-radius: 44rpx;
  background: #232730;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
}
.tilt-phone {
  font-size: 110rpx;
}
.gravity-state {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8b93a3;
}
.gravity-actions {
  display: flex;
  margin-top: 12rpx;
}

/* 控制条 */
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  background: #1a1d24;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-top: 28rpx;
}
.ctrl-item {
  display: flex;
  flex-direction: column;
  margin-right: 28rpx;
  margin-bottom: 16rpx;
}
.ctrl-item.wide {
  width: 100%;
  margin-right: 0;
}
.ctrl-label {
  font-size: 24rpx;
  color: #8b93a3;
  margin-bottom: 12rpx;
}
.toggle {
  min-width: 120rpx;
  padding: 14rpx 28rpx;
  border-radius: 18rpx;
  background: #232730;
  color: #8b93a3;
  font-size: 28rpx;
  font-weight: 700;
}
.toggle.on {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
}
.gear {
  display: flex;
  background: #232730;
  padding: 8rpx;
  border-radius: 18rpx;
}
.gear-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b93a3;
}
.gear-btn.active {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
}
.mini-btn {
  padding: 16rpx 28rpx;
  border-radius: 18rpx;
  background: #232730;
  color: #e6e9ef;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0 10rpx;
}
.gravity-actions .mini-btn {
  margin: 0 8rpx;
}

/* 日志 */
.log-zone {
  background: #1a1d24;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.log-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.log-head text {
  font-size: 24rpx;
  color: #8b93a3;
}
.mini-btn.ghost {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #8b93a3;
  padding: 8rpx 20rpx;
}
.log {
  height: 240rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  color: #9fb0c3;
}
.log-line {
  word-break: break-all;
}
.log-line.ok {
  color: #34d399;
}
.log-line.err {
  color: #f87171;
}
.log-line.warn {
  color: #fbbf24;
}

.foot {
  margin-top: 32rpx;
  font-size: 20rpx;
  color: #5b6373;
  text-align: center;
  line-height: 1.6;
}

/* 隐私授权弹窗 */
.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.privacy-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #1b2029;
  border: 1rpx solid #2c3442;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}
.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f3f6fb;
  text-align: center;
}
.privacy-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #9fb0c3;
}
.privacy-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #22d3ee;
}
.privacy-actions {
  margin-top: 36rpx;
  display: flex;
}
.privacy-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  border: none;
}
.privacy-btn.ghost {
  background: #2a3240;
  color: #c8d2e0;
  margin-right: 20rpx;
}
.privacy-btn.primary {
  background: #22d3ee;
  color: #0f1115;
  font-weight: 600;
}

/* ==================== 双手柄 / 横屏布局 ==================== */
.angle-readout {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b93a3;
}
.angle-val {
  color: #22d3ee;
  font-size: 32rpx;
  font-weight: 700;
}

/* 左手：只保留前进 / 后退 */
.throttle-pad {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.throttle-btn {
  width: 260rpx;
  height: 150rpx;
  margin: 0;
  border-radius: 32rpx;
  font-size: 64rpx;
}
.throttle-btn.up {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(59, 130, 246, 0.2));
  box-shadow: inset 0 0 0 2rpx rgba(34, 211, 238, 0.3), 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}
.throttle-btn.down {
  background: linear-gradient(135deg, rgba(248, 113, 113, 0.16), rgba(59, 130, 246, 0.12));
  box-shadow: inset 0 0 0 2rpx rgba(248, 113, 113, 0.25), 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}
.app.dual .dbtn.throttle-btn.held {
  background: linear-gradient(135deg, #22d3ee, #3b82f6);
  color: #04121a;
  transform: scale(.94);
}

/* 双区：竖屏上下堆叠、横屏左右分列 */
.app.dual .panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.app.dual .pane {
  flex: 1;
  min-width: 0;
  justify-content: center;
}
.app.wide.dual .panel {
  flex-direction: row;
  align-items: stretch;
}
.app.wide.dual .pane {
  padding: 0 8px;
}
.app.dual .joystick.steer-only .joystick-cross::before {
  display: none;
}
.app.dual .joystick.steer-only .joystick-cross::after {
  height: 2rpx;
  background: rgba(34, 211, 238, 0.24);
}

/* 横屏：rpx 基准会按屏幕宽度放大近一倍，因此这一整段必须用 px */
.app.wide {
  height: 100vh;
  box-sizing: border-box;
  padding: 6px 10px;
  display: flex;
  flex-direction: column;
}
.app.wide .topbar {
  margin-bottom: 4px;
}
.app.wide .logo {
  font-size: 18px;
  margin-right: 6px;
}
.app.wide .title {
  font-size: 14px;
}
.app.wide .sub {
  font-size: 10px;
}
.app.wide .pill {
  font-size: 11px;
  padding: 3px 8px;
  margin-right: 6px;
}
.app.wide .battery {
  font-size: 11px;
  min-width: 40px;
}
.app.wide .connect-btn {
  height: 32px;
  line-height: 32px;
  font-size: 13px;
  border-radius: 8px;
  letter-spacing: 0;
}
.app.wide .compat-note {
  margin-top: 2px;
  font-size: 10px;
}
.app.wide .tabs {
  margin: 4px 0;
  padding: 3px;
  border-radius: 8px;
}
.app.wide .tab {
  padding: 5px 0;
  font-size: 12px;
  border-radius: 6px;
}
.app.wide .panel {
  flex: 1;
  min-height: 0;
}
.app.wide .pane {
  justify-content: center;
}
.app.wide .demo-note {
  display: none;
}
.app.wide .hint {
  margin-top: 4px;
  font-size: 10px;
  line-height: 1.35;
}
.app.wide .readout {
  margin-top: 4px;
}
.app.wide .readout text {
  font-size: 11px;
  margin: 0 8px;
}
.app.wide .dir-state {
  margin-top: 2px;
  font-size: 11px;
}
.app.wide .angle-readout {
  margin-top: 3px;
  font-size: 11px;
  gap: 4px;
}
.app.wide .angle-val {
  font-size: 13px;
}
.app.wide .controls {
  margin-top: 4px;
  padding: 5px 8px;
  border-radius: 8px;
  flex-wrap: nowrap;
  align-items: center;
}
.app.wide .ctrl-item {
  margin: 0 8px 0 0;
  flex-direction: row;
  align-items: center;
}
.app.wide .ctrl-label {
  margin-bottom: 0;
  font-size: 10px;
  white-space: nowrap;
}
.app.wide .toggle {
  min-width: 38px;
  padding: 3px 8px;
  font-size: 11px;
  border-radius: 6px;
}
.app.wide .gear-btn {
  padding: 3px 8px;
  font-size: 11px;
}
.app.wide .mini-btn {
  padding: 4px 8px;
  font-size: 11px;
  margin: 0 4px;
}
.app.wide .ctrl-item.wide {
  flex: 1;
  margin-right: 8px;
}
.app.wide .trim-slider {
  flex: 1;
  min-width: 60px;
  margin: 0;
}
.app.wide .log-zone {
  margin-top: 4px;
  padding: 4px 8px;
  border-radius: 8px;
}
.app.wide .log-head {
  display: none;
}
.app.wide .log {
  height: 28px;
  font-size: 9px;
  line-height: 14px;
}
.app.wide .foot {
  display: none;
}

/* 横屏控件用固定 px，避免 rpx 放大溢出 */
.app.wide .dbtn {
  width: 50px;
  height: 50px;
  margin: 3px;
  border-radius: 12px;
  font-size: 20px;
}
.app.wide .dpad-cell {
  width: 50px;
  height: 50px;
}
.app.wide .dbtn.throttle-btn {
  width: 150px;
  height: 60px;
  margin: 0;
  border-radius: 14px;
  font-size: 24px;
}
.app.wide .throttle-pad {
  gap: 8px;
}
.app.wide .joystick {
  width: 150px;
  height: 150px;
}
.app.wide .joystick-knob {
  width: 50px;
  height: 50px;
  margin-left: -25px;
  margin-top: -25px;
}
.app.wide .gravity-tilt {
  width: 130px;
  height: 130px;
  border-radius: 20px;
}
.app.wide .tilt-phone {
  font-size: 38px;
}
